<div class="text-center py-20">
  <h1 class="text-6xl font-bold text-gray-200">500</h1>
  <p class="mt-4 text-lg text-gray-600">서버 오류가 발생했습니다.</p>
  <% if (typeof error !== 'undefined' && error) { %>
    <pre class="mt-4 text-left max-w-2xl mx-auto p-4 bg-gray-100 rounded-lg text-sm text-red-600 overflow-auto"><%= error.stack || error %></pre>
  <% } %>
  <a href="/" class="mt-6 inline-block px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">홈으로 돌아가기</a>
</div>
