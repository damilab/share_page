<div class="max-w-5xl mx-auto">
  <div class="mb-6 flex items-start justify-between">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <a href="/?category=<%= post.category %>" class="inline-block px-2.5 py-0.5 text-xs font-medium rounded-full bg-<%= categoryInfo ? categoryInfo.color : 'gray' %>-100 text-<%= categoryInfo ? categoryInfo.color : 'gray' %>-700">
          <%= categoryInfo ? categoryInfo.label : post.category %>
        </a>
        <% if (post.tags && post.tags.length > 0) { %>
          <% post.tags.forEach(tag => { %>
            <a href="/?tag=<%= encodeURIComponent(tag.name) %>" class="inline-block px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-600 hover:bg-gray-200 transition">
              #<%= tag.name %>
            </a>
          <% }) %>
        <% } %>
        <span class="text-xs text-gray-400"><%= formatDate(post.created_at) %></span>
        <% if (post.updated_at !== post.created_at) { %>
          <span class="text-xs text-gray-400">(수정: <%= formatDate(post.updated_at) %>)</span>
        <% } %>
      </div>
      <h1 class="text-2xl font-bold text-gray-900"><%= post.title %></h1>
      <% if (parentPost) { %>
        <div class="mt-1 text-xs text-gray-500">
          ↳ Branched from <a href="/posts/<%= parentPost.id %>" class="text-indigo-600 hover:underline"><%= parentPost.title %></a>
        </div>
      <% } %>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <button id="copy-raw-btn" data-post-id="<%= post.id %>"
              class="inline-flex items-center gap-1 px-3 py-1.5 text-sm border rounded-lg hover:bg-gray-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184"/></svg>
        Copy MD
      </button>
      <a href="/posts/new?from=<%= post.id %>"
         class="inline-flex items-center gap-1 px-3 py-1.5 text-sm border rounded-lg hover:bg-gray-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 3v12m0 0a3 3 0 106 0m-6 0a3 3 0 116 0m0 0V9a3 3 0 013-3h3m-3 0l3-3m-3 3l3 3"/>
        </svg>
        Branch
      </a>
      <a href="/posts/<%= post.id %>/edit" class="inline-flex items-center gap-1 px-3 py-1.5 text-sm border rounded-lg hover:bg-gray-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
        Edit
      </a>
      <form method="POST" action="/posts/<%= post.id %>" onsubmit="return confirm('정말 삭제하시겠습니까?')">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 text-sm border border-red-200 text-red-600 rounded-lg hover:bg-red-50 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
          Delete
        </button>
      </form>
    </div>
  </div>

  <div class="flex gap-6 <% if (fileTree || hasBranchTree) { %>flex-col lg:flex-row<% } %>">
    <div class="flex-1 min-w-0">
      <div class="bg-white rounded-xl border p-6 lg:p-8">
        <div class="prose prose-gray max-w-none">
          <%- renderedBody %>
        </div>
      </div>

      <!-- Comments Section -->
      <div class="bg-white rounded-xl border p-6 lg:p-8 mt-6" id="comments">
        <h3 class="font-semibold text-gray-900 mb-4">Comments (<%= comments.length %>)</h3>

        <% if (comments.length > 0) { %>
          <div class="space-y-4 mb-6">
            <% comments.forEach(comment => { %>
              <div class="border-b pb-4 last:border-b-0">
                <div class="flex items-center justify-between mb-1">
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-medium text-gray-700"><%= comment.author %></span>
                    <span class="text-xs text-gray-400"><%= formatDate(comment.created_at) %></span>
                  </div>
                  <form method="POST" action="/posts/<%= post.id %>/comments/<%= comment.id %>/delete" onsubmit="return confirm('댓글을 삭제하시겠습니까?')">
                    <button type="submit" class="text-xs text-gray-400 hover:text-red-500">삭제</button>
                  </form>
                </div>
                <p class="text-sm text-gray-600 whitespace-pre-wrap"><%= comment.body %></p>
              </div>
            <% }) %>
          </div>
        <% } %>

        <form method="POST" action="/posts/<%= post.id %>/comments" class="space-y-3">
          <input type="text" name="author" placeholder="닉네임 (선택, 비워두면 Anonymous)"
                 class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
          <textarea name="body" rows="3" required placeholder="댓글을 작성하세요..."
                    class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"></textarea>
          <div class="flex justify-end">
            <button type="submit" class="px-4 py-1.5 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
              Comment
            </button>
          </div>
        </form>
      </div>
    </div>

    <% if (fileTree || hasBranchTree) { %>
    <div class="lg:w-80 flex-shrink-0 space-y-4">
      <% if (fileTree) { %>
      <div class="bg-white rounded-xl border sticky top-20">
        <div class="p-4 border-b flex items-center justify-between">
          <h3 class="font-semibold text-sm text-gray-900">
            <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"/></svg>
            <%= post.attachment_original_name || 'Attachment' %>
          </h3>
          <a href="/api/posts/<%= post.id %>/download" class="text-xs text-indigo-600 hover:text-indigo-800 font-medium">Download</a>
        </div>
        <div class="file-tree p-3 max-h-96 overflow-y-auto text-sm" id="file-tree" data-post-id="<%= post.id %>">
          <%- include('../partials/file-tree-items', { items: fileTree }) %>
        </div>
        <div id="file-preview-panel" class="border-t hidden">
          <div class="p-3 bg-gray-50 border-b flex items-center justify-between">
            <span id="preview-filename" class="text-xs font-medium text-gray-700 truncate"></span>
            <div class="flex items-center gap-2">
              <button id="preview-copy-btn" class="text-xs text-gray-500 hover:text-gray-700">Copy</button>
              <a id="preview-download-link" href="#" class="text-xs text-indigo-600 hover:text-indigo-800">Download</a>
              <button id="preview-close-btn" class="text-xs text-gray-400 hover:text-gray-600">✕</button>
            </div>
          </div>
          <div id="preview-content" class="p-3 max-h-80 overflow-auto"></div>
        </div>
      </div>
      <% } %>

      <% if (hasBranchTree) { %>
        <%- include('../partials/branch-tree', { rows: branchRows }) %>
      <% } %>
    </div>
    <% } %>
  </div>
</div>

<script src="/js/copy-buttons.js" defer></script>
<% if (fileTree) { %>
<script src="/js/file-tree.js" defer></script>
<% } %>
