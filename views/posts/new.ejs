<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">New Post</h1>

  <form method="POST" action="/posts" enctype="multipart/form-data" id="post-form">
    <div class="bg-white rounded-xl border p-6 space-y-5">
      <% if (parent) { %>
        <div class="mb-4 flex items-center justify-between p-3 bg-indigo-50 border border-indigo-100 rounded-lg">
          <div class="flex items-center gap-2 text-sm text-indigo-900">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 3v12m0 0a3 3 0 106 0m-6 0a3 3 0 116 0m0 0V9a3 3 0 013-3h3m-3 0l3-3m-3 3l3 3"/>
            </svg>
            <span>Branched from <a href="/posts/<%= parent.id %>" class="font-semibold hover:underline"><%= parent.title %></a></span>
          </div>
          <a href="/posts/new" class="text-xs text-indigo-600 hover:underline">Start from blank</a>
        </div>
      <% } %>
      <div>
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Title</label>
        <input type="text" name="title" id="title" required
               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
               placeholder="게시글 제목을 입력하세요"
               value="<%= parent ? parent.prefillTitle : '' %>">
      </div>

      <div>
        <label for="category" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
        <select name="category" id="category" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
          <% categoryTree.forEach(cat => { %>
            <option value="<%= cat.slug %>" <%= (parent && parent.category === cat.slug) ? 'selected' : '' %>><%= cat.label %></option>
            <% cat.children.forEach(child => { %>
              <option value="<%= child.slug %>" <%= (parent && parent.category === child.slug) ? 'selected' : '' %>>&nbsp;&nbsp;&nbsp;&nbsp;└ <%= child.label %></option>
            <% }) %>
          <% }) %>
        </select>
      </div>

      <div class="relative">
        <label for="tags" class="block text-sm font-medium text-gray-700 mb-1">Tags</label>
        <input type="text" name="tags" id="tags"
               class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
               placeholder="콤마로 구분하여 태그 입력 (예: claude-code, skills, tips)"
               autocomplete="off"
               value="<%= prefillTags || '' %>">
        <div id="tag-suggestions" class="hidden absolute z-10 w-full bg-white border rounded-lg shadow-lg mt-1 max-h-40 overflow-y-auto"></div>
      </div>

      <div>
        <label for="body" class="block text-sm font-medium text-gray-700 mb-1">Content (Markdown)</label>
        <textarea name="body" id="body" rows="16"
                  class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent font-mono text-sm"
                  placeholder="Markdown으로 내용을 작성하세요..."><%= parent ? parent.body : '' %></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Attachment</label>
        <div class="flex gap-2 mb-2">
          <button type="button" id="tab-upload" class="px-3 py-1 text-sm rounded-md bg-gray-100 text-gray-900 font-medium" onclick="document.getElementById('upload-section').classList.remove('hidden'); document.getElementById('github-section').classList.add('hidden'); this.classList.add('bg-gray-100','text-gray-900'); document.getElementById('tab-github').classList.remove('bg-gray-100','text-gray-900');">
            File Upload
          </button>
          <button type="button" id="tab-github" class="px-3 py-1 text-sm rounded-md text-gray-600 hover:bg-gray-50" onclick="document.getElementById('github-section').classList.remove('hidden'); document.getElementById('upload-section').classList.add('hidden'); this.classList.add('bg-gray-100','text-gray-900'); document.getElementById('tab-upload').classList.remove('bg-gray-100','text-gray-900');">
            GitHub Import
          </button>
        </div>
        <div id="upload-section">
          <div id="dropzone" class="dropzone">
            <svg class="mx-auto w-10 h-10 text-gray-300 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
            <p class="text-sm text-gray-600">파일이나 폴더를 드래그앤드롭하거나 <label for="file-input" class="text-indigo-600 cursor-pointer hover:underline">파일을 선택</label>하세요</p>
            <p class="text-xs text-gray-400 mt-1">폴더 드롭 시 자동으로 ZIP으로 패키징됩니다</p>
            <input type="file" id="file-input" name="attachment" multiple class="hidden">
          </div>
        </div>
        <div id="github-section" class="hidden">
          <div class="flex gap-2">
            <input type="text" id="github-url" placeholder="https://github.com/user/repo/tree/main/path"
                   class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
            <button type="button" id="github-import-btn"
                    class="px-4 py-2 text-sm font-medium text-white bg-gray-800 rounded-lg hover:bg-gray-900 transition flex items-center gap-1">
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
              Import
            </button>
          </div>
          <p class="text-xs text-gray-400 mt-1">GitHub repo, folder, 또는 ��일 URL을 입력하세요 (public repo만 지원)</p>
          <div id="github-status" class="hidden mt-2 text-sm"></div>
        </div>
        <div id="file-info" class="hidden mt-2 p-3 bg-gray-50 rounded-lg flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span id="file-name" class="text-sm text-gray-700"></span>
            <span id="file-size" class="text-xs text-gray-400"></span>
          </div>
          <button type="button" id="remove-file" class="text-sm text-red-500 hover:text-red-700">Remove</button>
        </div>
        <div id="zip-progress" class="hidden mt-2">
          <div class="flex items-center gap-2">
            <div class="flex-1 bg-gray-200 rounded-full h-2">
              <div id="zip-progress-bar" class="bg-indigo-600 h-2 rounded-full transition-all" style="width: 0%"></div>
            </div>
            <span id="zip-progress-text" class="text-xs text-gray-500">0%</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4 flex items-center justify-end gap-3">
      <a href="/" class="px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg transition">Cancel</a>
      <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
        Create Post
      </button>
    </div>
    <% if (parent) { %>
      <input type="hidden" name="parent_id" value="<%= parent.id %>">
    <% } %>
  </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="/js/dropzone.js" defer></script>
<script src="/js/tag-input.js" defer></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const btn = document.getElementById('github-import-btn');
  const urlInput = document.getElementById('github-url');
  const status = document.getElementById('github-status');
  const form = document.getElementById('post-form');
  if (!btn) return;

  let githubAttachment = null;

  btn.addEventListener('click', async () => {
    const url = urlInput.value.trim();
    if (!url) return;
    status.classList.remove('hidden');
    status.innerHTML = '<span class="text-indigo-600">GitHub에서 가져오는 중...</span>';
    btn.disabled = true;
    try {
      const res = await fetch('/api/github-import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });
      const data = await res.json();
      if (data.error) throw new Error(data.error);
      githubAttachment = data;
      status.innerHTML = '<span class="text-green-600">Imported: ' + data.attachment_original_name + ' (' + (data.attachment_file_tree || []).length + ' items)</span>';

      // Add hidden inputs for the imported attachment
      let h1 = document.getElementById('gh-attachment-id');
      let h2 = document.getElementById('gh-attachment-name');
      let h3 = document.getElementById('gh-attachment-tree');
      if (!h1) { h1 = document.createElement('input'); h1.type = 'hidden'; h1.name = 'github_attachment_id'; h1.id = 'gh-attachment-id'; form.appendChild(h1); }
      if (!h2) { h2 = document.createElement('input'); h2.type = 'hidden'; h2.name = 'github_attachment_name'; h2.id = 'gh-attachment-name'; form.appendChild(h2); }
      if (!h3) { h3 = document.createElement('input'); h3.type = 'hidden'; h3.name = 'github_attachment_tree'; h3.id = 'gh-attachment-tree'; form.appendChild(h3); }
      h1.value = data.attachment_id;
      h2.value = data.attachment_original_name;
      h3.value = JSON.stringify(data.attachment_file_tree);
    } catch (err) {
      status.innerHTML = '<span class="text-red-600">Error: ' + err.message + '</span>';
    }
    btn.disabled = false;
  });
});
</script>
